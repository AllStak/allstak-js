{
  "name": "allstak-js",
  "version": "0.1.1",
  "description": "Official AllStak JavaScript/TypeScript SDK \u2014 error tracking, structured logs, HTTP + DB monitoring, distributed tracing, and cron monitoring for Node.js applications.",
  "main": "./dist/node/index.js",
  "module": "./dist/node/index.mjs",
  "types": "./dist/node/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.mjs",
      "require": "./dist/node/index.js"
    },
    "./react": {
      "types": "./dist/browser/react.d.ts",
      "import": "./dist/browser/react.mjs",
      "require": "./dist/browser/react.js"
    },
    "./react-native": {
      "types": "./dist/browser/react-native.d.ts",
      "import": "./dist/browser/react-native.mjs",
      "require": "./dist/browser/react-native.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.mjs",
      "require": "./dist/browser/index.js"
    },
    "./express": {
      "types": "./dist/node/express.d.ts",
      "import": "./dist/node/express.mjs",
      "require": "./dist/node/express.js"
    },
    "./cron": {
      "types": "./dist/browser/cron.d.ts",
      "import": "./dist/browser/cron.mjs",
      "require": "./dist/browser/cron.js"
    },
    "./db": {
      "types": "./dist/browser/db.d.ts",
      "import": "./dist/browser/db.mjs",
      "require": "./dist/browser/db.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/allstak-io/allstak-js.git"
  },
  "homepage": "https://allstak.sa",
  "bugs": {
    "url": "https://github.com/allstak-io/allstak-js/issues"
  },
  "keywords": [
    "allstak",
    "observability",
    "monitoring",
    "error-tracking",
    "apm",
    "tracing",
    "nodejs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write src",
    "clean": "rm -rf dist",
    "prepublishOnly": "tsup",
    "prepare": "tsup"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.2.0",
    "react": "^18.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.3.0"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  }
}
