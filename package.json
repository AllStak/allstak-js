{
  "name": "@allstak/js",
  "version": "0.3.2",
  "description": "Official AllStak JavaScript/TypeScript SDK — error tracking, structured logs, HTTP + DB monitoring, distributed tracing, and cron monitoring for Node.js applications.",
  "main": "./dist/node/index.js",
  "module": "./dist/node/index.mjs",
  "types": "./dist/node/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.mjs",
      "require": "./dist/node/index.js"
    },
    "./react": {
      "types": "./dist/browser/react.d.ts",
      "import": "./dist/browser/react.mjs",
      "require": "./dist/browser/react.js"
    },
    "./react-native": {
      "types": "./dist/browser/react-native.d.ts",
      "import": "./dist/browser/react-native.mjs",
      "require": "./dist/browser/react-native.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.mjs",
      "require": "./dist/browser/index.js"
    },
    "./express": {
      "types": "./dist/node/express.d.ts",
      "import": "./dist/node/express.mjs",
      "require": "./dist/node/express.js"
    },
    "./cron": {
      "types": "./dist/browser/cron.d.ts",
      "import": "./dist/browser/cron.mjs",
      "require": "./dist/browser/cron.js"
    },
    "./db": {
      "types": "./dist/browser/db.d.ts",
      "import": "./dist/browser/db.mjs",
      "require": "./dist/browser/db.js"
    },
    "./sourcemaps": {
      "types": "./dist/node/sourcemaps.d.ts",
      "import": "./dist/node/sourcemaps.mjs",
      "require": "./dist/node/sourcemaps.js"
    },
    "./vite": {
      "types": "./dist/node/vite.d.ts",
      "import": "./dist/node/vite.mjs",
      "require": "./dist/node/vite.js"
    },
    "./webpack": {
      "types": "./dist/node/webpack.d.ts",
      "import": "./dist/node/webpack.mjs",
      "require": "./dist/node/webpack.js"
    },
    "./next": {
      "types": "./dist/node/next.d.ts",
      "import": "./dist/node/next.mjs",
      "require": "./dist/node/next.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AllStak/allstak-js.git"
  },
  "homepage": "https://allstak.sa",
  "bugs": {
    "url": "https://github.com/AllStak/allstak-js/issues"
  },
  "keywords": [
    "allstak",
    "observability",
    "monitoring",
    "error-tracking",
    "apm",
    "tracing",
    "nodejs"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write src",
    "clean": "rm -rf dist",
    "release:check": "pnpm run clean && pnpm run type-check && pnpm run test && pnpm run build && npm pack --dry-run",
    "release:publish": "pnpm run release:check && npm publish --access public",
    "release:patch": "pnpm run release:check && npm version patch --no-git-tag-version && npm publish --access public",
    "prepublishOnly": "tsup",
    "prepare": "tsup"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.2.0",
    "react": "^18.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.3.0"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "vite": ">=4.0.0",
    "webpack": ">=5.0.0",
    "next": ">=13.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
